# Runta control plane credential. Never commit a real value.
RUNTA_TOKEN=

# LLM credential. The control plane stores this in Runta as a tenant secret,
# then Runta runtime secret configuration injects it into matching outbound requests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_API_URL=https://api.openai.com/v1/responses

# Local service settings
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=./runta_eval.sqlite3
ARTIFACT_DIR=./artifacts
EXPERIMENT_DIR=./experiments

# Runta defaults. Keep these modest while learning the platform.
RUNTA_VCPUS=1
RUNTA_MEMORY_MIB=1024
RUNTA_MEMORY_MAX_MIB=2048
RUNTA_KEEP_RUNTIMES=true
RUNTA_SECRET_NAME=openai-api-key
RUNTA_IDLE_SUSPEND_SECS=0

# Candidate safety / cost guardrail.
MAX_CANDIDATES=12

# Agent loop guardrail. Keep modest; loop prevention should solve repetition before raising this.
AGENT_MAX_STEPS=24
